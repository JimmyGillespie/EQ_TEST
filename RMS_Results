def exposure_id_from_meta(js) -> str:
    """RP_GetExposureIdFromMeta"""
    v = gj(js, "exposureId")
    if v:
        return v
    v = gj(gobj(js, "exposure"), "id")
    if v:
        return v
    exps = gv(js, "exposures")
    if isinstance(exps, list):
        for it in exps:
            v = gj(it, "id")
            if v:
                return v
    return ""


def pull_rds(http: Http, c: Creds, analysis_id: str, app_id: str, account: str, dbg: list):
    """-> (layer, {eventid: rounded GR loss>0}). Appends the 'RDS Debug' rows to dbg."""
    rds_id = app_id or analysis_id
    meta_url = f"https://{c.host}/riskmodeler/v2/analyses/{rds_id}"
    r = http.get(meta_url, c.riskmodeler_key)
    meta = _json(r.text) if r.status == 200 else None
    if isinstance(meta, list):
        meta = meta[0] if meta else None
    meta = meta if isinstance(meta, dict) else {}
    name = gj(meta, "analysisName") or gj(meta, "name")
    layer = extract_layer(name) if "PORTFOLIO:" in name.upper() else account
    exp_id = exposure_id_from_meta(meta)
    dbg.append([len(dbg) + 1, analysis_id, name, layer, "META", r.status, meta_url,
                r.text[:RESP_SNIPPET_LEN], exp_id])
    if not exp_id:
        return layer, {}
    ids_q = "&".join(f"eventIds={k}" for k in EVENT_MAP)
    url = (f"https://{c.host}/riskmodeler/v2/analyses/{rds_id}/elt?limit={RDS_API_LIMIT}"
           f"&exposureId={exp_id}&exposureType={EXPOSURE_TYPE}&perspective=GR&{ids_q}")
    r2 = http.get(url, c.riskmodeler_key)
    dbg.append([len(dbg) + 1, analysis_id, name, layer, "GR", r2.status, url,
                r2.text[:RESP_SNIPPET_LEN], exp_id])
    payload = _json(r2.text) if r2.status == 200 else None
    if isinstance(payload, dict) and isinstance(payload.get("items"), list):
        payload = payload["items"]
    sums = {}
    if isinstance(payload, list):
        for v in payload:
            if isinstance(v, dict):
                eid = gj(v, "eventid")
                val = to_num(gv(v, "perspvalue")) or 0.0
                if eid:
                    sums[eid] = sums.get(eid, 0.0) + val
    out = {}
    for eid in EVENT_MAP:
        loss = sums.get(eid, 0.0)
        if loss > 0:
            out[eid] = float(round(loss))      # VBA Round() == banker's rounding == Python round()
    return layer, out


