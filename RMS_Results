# Analysis-ID resolution
# --------------------------------------------------------------------------
def find_analysis_by_name(http: Http, c: Creds, name: str):
    """MI_FindAnalysisIdByName, but returns the LATEST (highest analysisId) exact-name match
    because re-running the same account re-uses the same analysis name.
    -> {'analysisId','appAnalysisId','analysisName'} or None"""
    filt = 'analysisName="' + name + '"'
    url = f"{riskdata_base(c)}/analyses?filter={url_encode(filt)}&limit=100"
    r = http.get(url, c.riskdata_key)
    if r.status != 200:
        return None
    best = None
    for it in _as_list(_json(r.text)):
        aid = gj(it, "analysisId")
        if aid.isdigit() and gj(it, "analysisName") == name:
            if best is None or int(aid) > int(best["analysisId"]):
                best = {"analysisId": aid, "appAnalysisId": gj(it, "appAnalysisId"), "analysisName": name}
    return best


def resolve_app_ids(http: Http, c: Creds, wanted: set) -> dict:
    """MI_ResolveAppIdsBulk: page /analyses, map appAnalysisId -> analysisId."""
    found = {}
    for page in range(SCAN_PAGES):
        url = f"{riskdata_base(c)}/analyses?offset={page * SCAN_PAGE_SIZE}&limit={SCAN_PAGE_SIZE}"
        r = http.get(url, c.riskdata_key)
        if r.status != 200:
            break
        items = _as_list(_json(r.text))
        if not items:
            break
        for it in items:
            app = gj(it, "appAnalysisId")
            if app and app in wanted and app not in found:
                found[app] = gj(it, "analysisId")
        if all(w in found for w in wanted) or len(items) < SCAN_PAGE_SIZE:
            break
    return found


def ids_from_workflow_text(text: str) -> list:
    """Every plausible analysis id mentioned in a workflow/job response, in order."""
    out = []

    def add(v):
        s = _s(v)
        if s.isdigit() and s not in out:
            out.append(s)

    def walk(n):
        if isinstance(n, dict):
            for k, v in n.items():
                if str(k).lower() in ("analysisid", "appanalysisid"):
                    add(v)
                else:
                    walk(v)
        elif isinstance(n, list):
            for v in n:
                walk(v)
        elif isinstance(n, str):
            for m in re.findall(r"/analyses/(\d+)", n):
                add(m)

    p = _json(text or "")
    if p is not None:
        walk(p)
    for m in re.findall(r"/analyses/(\d+)", text or ""):
        add(m)
    return out


def resolve_quote_analysis(http: Http, c: Creds, edm_name: str, portfolio_name: str,
                           workflow_text: str = "", manual_id: str = "", log: Log = _noop) -> dict:
    """Find the just-run EQ analysis. Order: manual override -> exact analysisName
    ('<EDM>: PORTFOLIO: <portfolio>') -> ids mentioned in the analysis workflow response."""
    manual_id = (manual_id or "").strip()
    if manual_id.isdigit():
        meta = fetch_meta(http, c, manual_id)
        if meta:
            log(f"Using manual analysisId {manual_id}")
            return {"analysisId": gj(meta, "analysisId") or manual_id,
                    "appAnalysisId": gj(meta, "appAnalysisId"), "analysisName": gj(meta, "analysisName")}
        scanned = resolve_app_ids(http, c, {manual_id})
        if manual_id in scanned:
            return {"analysisId": scanned[manual_id], "appAnalysisId": manual_id, "analysisName": ""}
        raise RuntimeError(f"Manual analysis id {manual_id} could not be found in platform/riskdata/v1/analyses.")
    name = f"{edm_name}: PORTFOLIO: {portfolio_name}"
    hit = find_analysis_by_name(http, c, name)
    if hit:
        log(f"Resolved by analysisName '{name}' -> analysisId {hit['analysisId']} (app {hit['appAnalysisId'] or '?'})")
        return hit
    cands = ids_from_workflow_text(workflow_text)
    log(f"No analysis named '{name}'. Workflow response mentions ids: {cands or 'none'}")
    for cand in cands:
        scanned = resolve_app_ids(http, c, {cand})
        if cand in scanned:
            return {"analysisId": scanned[cand], "appAnalysisId": cand, "analysisName": ""}
        meta = fetch_meta(http, c, cand)
        if meta and "PORTFOLIO:" in gj(meta, "analysisName"):
            return {"analysisId": gj(meta, "analysisId") or cand,
                    "appAnalysisId": gj(meta, "appAnalysisId"), "analysisName": gj(meta, "analysisName")}
    raise RuntimeError(
        f"Could not resolve the EQ analysis for '{name}'. Type the analysis id into the manual override box.")


