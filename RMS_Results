def new_bundle() -> dict:
    return {
        "analyses": [],        # Results sheet entries
        "meta_rows": [],       # 16-col rows
        "rds_dbg": [],         # RDS Debug rows
        "rds_cols": {},        # '<layer>_GR' -> {eventid: value}
        "toploc_blocks": [],   # [(layer, rows)]
        "toploc_dbg": [],
        "locations": [],       # list of dicts (ALL_LOC_HEADERS)
        "map_rows": [],
        "mi": None,            # marginal impact dict
        "layer_rows": [],      # report-summary layer rows
        "notes": [],
    }


def pull_quote_stage(http: Http, c: Creds, ctx: dict, log: Log = _noop) -> dict:
    """Everything that does NOT depend on the grouping job. Returns state for the grouping stage."""
    bundle = new_bundle()
    q = resolve_quote_analysis(http, c, ctx["edm_name"], ctx["portfolio_name"],
                               ctx.get("workflow_text", ""), ctx.get("manual_quote_id", ""), log)
    qid = q["analysisId"]
    log(f"Quote (EQ) analysisId = {qid}")
    qdata = fetch_analysis_data(http, c, qid)
    if qdata is None:
        raise RuntimeError(f"Could not fetch analysis meta for analysisId {qid}.")
    layer = extract_layer(qdata["analysisName"]) if "PORTFOLIO:" in qdata["analysisName"].upper() \
        else ctx["account_key"]
    qdata["layer"] = layer
    bundle["analyses"].append({"data": {k: qdata[k] for k in qdata if k not in ("epDict", "statsDict")} | {
        "epDict": {k: v for k, v in qdata["epDict"].items() if k.startswith(("GU_", "GR_"))},
        "statsDict": {k: v for k, v in qdata["statsDict"].items() if k in ("GU", "GR")}},
        "layer": layer, "grouping_id": None})
    bundle["meta_rows"].append(meta_row(qdata))
    log(f"EP + stats pulled for layer {layer}")

    app_id = q.get("appAnalysisId") or qdata.get("appAnalysisId") or ""
    layer_rds, rds = pull_rds(http, c, qid, app_id, ctx["account_key"], bundle["rds_dbg"])
    bundle["rds_cols"][f"{layer_rds}_GR"] = rds
    log(f"RDS: {len(rds)} event(s) with GR loss > 0")

    all_locs = None
    if ctx.get("run_toploc") or ctx.get("run_locations"):
        all_locs = fetch_all_locations(http, c, ctx["exposure_id"], log)
    if ctx.get("run_toploc"):
        lyr, rows = pull_top_locations(http, c, qid, ctx["account_key"], ctx["exposure_id"],
                                       bundle["toploc_dbg"], all_locs, log)
        bundle["toploc_blocks"].append((lyr, rows))
        log(f"Top Locations: {len(rows)} row(s)")
    if ctx.get("run_locations"):
        rows, mp = pull_locations_and_hazards(http, c, ctx["exposure_id"], ctx["account_key"],
                                              ctx.get("loc_fallback"), ctx.get("run_hazard", True),
                                              all_locs, log)
        bundle["locations"], bundle["map_rows"] = rows, mp
        log(f"Locations: {len(rows)} row(s) (hazard lookups {'on' if ctx.get('run_hazard', True) else 'off'})")

    state = {"stage": "done", "bundle": bundle, "layer": layer, "quote_id": qid, "quote_data": qdata,
             "log": [], "group": None, "portfolio_data": None}

    if ctx.get("run_mi"):
        # in-force portfolio
        pid = (ctx.get("inforce_long_id") or "").strip()
        papp = (ctx.get("inforce_app_id") or "").strip()
        if not pid.isdigit():
            if not papp.isdigit():
                raise RuntimeError("Marginal Impact needs the in-force Portfolio analysis id (Controls!A2).")
            log(f"Resolving in-force app analysisId {papp} ...")
            got = resolve_app_ids(http, c, {papp})
            if papp not in got:
                raise RuntimeError(f"Could not resolve in-force appAnalysisId {papp}; type the long analysisId "
                                   f"(Controls!B2) into the override box.")
            pid = got[papp]
        if pid == qid:
            raise RuntimeError("In-force Portfolio and Quote resolved to the SAME analysisId - check the in-force id.")
        pdata = fetch_analysis_data(http, c, pid)
        if pdata is None:
            raise RuntimeError(f"Could not fetch EP/stats for the in-force Portfolio analysisId {pid}.")
        pdata["layer"] = layer
        log(f"In-force Portfolio analysisId = {pid}")
        cur_code = pdata["currencyCode"] or "USD"
        cur_vint = pdata["currencyVintage"] or "RL24"
        cur_asof = pdata["currencyAsOf"] or "2024-04-03"
        ok, url, raw, gname = create_grouping_job(http, c, pid, qid, layer, cur_code, cur_vint, cur_asof)
        if not ok:
            raise RuntimeError("Failed to create the Analysis Group (grouping job). " + raw[:600])
        log(f"Grouping job submitted: {url}")
        state.update(stage="grouping", portfolio_data=pdata)
        state["group"] = {"job_url": url, "group_name": gname, "polls": 0, "status": "SUBMITTED",
                          "last_resp": "", "portfolio_id": pid, "quote_id": qid, "group_id": ""}
    return state


def advance_grouping(http: Http, c: Creds, state: dict, log: Log = _noop) -> dict:
    """One poll. On FINISHED: resolve the group id, fetch Quote/Grouped/Portfolio data, fill the
    bundle's 'mi' block. Moves stage to 'done' or 'failed'."""
    g = state["group"]
    g["polls"] += 1
    st, text = poll_grouping_job(http, c, g["job_url"])
    g["status"], g["last_resp"] = st, text
    log(f"Grouping status: {st}")
    if st == "FINISHED":
        gid = extract_grouped_analysis_id(text, g["portfolio_id"], g["quote_id"])
        if not gid:
            hit = find_analysis_by_name(http, c, g["group_name"])
            gid = hit["analysisId"] if hit else ""
        if not gid:
            state["stage"] = "failed"
            state["error"] = ("Grouping job FINISHED but the resulting group's analysisId could not be identified "
                              f"(searched analysisName='{g['group_name']}'). Raw: {text[:500]}")
            return state
        g["group_id"] = gid
        gdata = fetch_analysis_data(http, c, gid)
        if gdata is None:
            state["stage"] = "failed"
            state["error"] = f"Grouping finished (group {gid}) but EP/stats fetch failed - no delta block written."
            return state
        gdata["layer"] = state["layer"]
        state["bundle"]["mi"] = {"layer": state["layer"], "quote": state["quote_data"],
                                 "portfolio": state["portfolio_data"], "grouped": gdata,
                                 "quote_id": state["quote_id"], "portfolio_id": g["portfolio_id"], "group_id": gid}
        # MI_AppendGroupedAnalysisToMeta: 16-col row, only the columns the VBA fills
        row = [None] * 16
        row[0], row[1], row[2], row[3] = gid, gdata["analysisName"], state["layer"], gdata["peril"]
        row[4], row[5], row[6] = gdata["region"], gdata["engineVersion"], gdata["lossAmplification"]
        row[7], row[8], row[9] = gdata["currencyCode"], gdata["currencyName"], gdata["currencyVintage"]
        row[13] = gdata["portfolioName"]
        row[15] = f"https://api-euw1.rms.com/platform/riskdata/v1/analyses/{gid}"
        state["bundle"]["meta_rows"].append(row)
        state["stage"] = "done"
    elif st in ("FAILED", "CANCELLED", "CANCELED"):
        state["stage"] = "failed"
        state["error"] = f"Grouping job ended with status '{st}'. Raw: {text[:500]}"
    elif g["polls"] >= GROUP_POLL_MAX_ATTEMPTS:
        state["stage"] = "failed"
        state["error"] = "Grouping job did not reach a terminal status within the polling limit."
    return state
