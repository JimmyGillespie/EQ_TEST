def fetch_all_locations(http: Http, c: Creds, exposure_id: str, log: Log = _noop) -> list:
    """Page .../exposures/{id}/locations exactly like LH_Pull... / RP_BuildLocationDetailMap..."""
    out, offset = [], 0
    while True:
        url = f"{riskdata_base(c)}/exposures/{exposure_id}/locations?limit={LOC_PAGE_LIMIT}&offset={offset}"
        r = http.get(url, c.riskdata_key)
        if r.status != 200:
            log(f"locations fetch failed at offset {offset}: HTTP {r.status} {r.text[:200]}")
            break
        items = _json(r.text)
        if not isinstance(items, list) or not items:
            break
        out.extend(items)
        if len(items) < LOC_PAGE_LIMIT:
            break
        offset += LOC_PAGE_LIMIT
        if offset > 200000:
            break
    return out


def location_tiv_from_detail(http: Http, c: Creds, exposure_id: str, loc_id: str) -> float:
    """RP_GetTivFromLocationDetail"""
    if not loc_id:
        return 0.0
    r = http.get(f"{riskdata_base(c)}/exposures/{exposure_id}/locations/{loc_id}", c.riskdata_key)
    if r.status != 200:
        return 0.0
    d = _json(r.text)
    if not isinstance(d, dict):
        return 0.0
    bldg = to_num(d.get("maxCvgBldgValuation")) or 0.0
    cont = bi = 0.0
    for cov in d.get("locationCoverages") or []:
        lt = gj(cov, "lossType").lower()
        if lt == "contents":
            cont = to_num(gv(cov, "value")) or 0.0
        elif lt in ("bi", "business interruption"):
            bi = to_num(gv(cov, "value")) or 0.0
    return bldg + cont + bi


def build_location_detail_map(all_locs: list) -> dict:
    """RP_BuildLocationDetailMapForExposure: locationId -> 11-tuple."""
    res = {}
    for lw in all_locs:
        if not isinstance(lw, dict):
            continue
        loc = gobj(lw, "location")
        if not loc:
            continue
        prop, addr = gobj(loc, "property"), gobj(loc, "address")
        lid = gj(prop, "locationId")
        if not lid or lid in res:
            continue
        tiv = gv(lw, "tiv")
        if to_num(tiv) is None:
            tiv = gv(loc, "tiv")
        tiv = to_num(tiv) or 0.0
        res[lid] = (gj(prop, "locationName"), gj(prop, "locationNumber"), gj(addr, "streetAddress"),
                    gj(addr, "cityName"), gj(addr, "postalCode"), gj(gobj(addr, "country"), "name"),
                    strip_prefix(gj(gobj(prop, "occupancyType"), "name")),
                    strip_prefix(gj(gobj(prop, "buildingClass"), "name")),
                    gv(prop, "yearBuilt"), gv(prop, "stories"), tiv)
    return res


TOPLOC_HEADERS = ["Layer", "Analysis ID", "Rank", "Location ID", "Location Name", "Location Number",
                  "Street Address", "City", "Postal Code", "Country", "Occupancy", "Building Class",
                  "Year Built", "Stories", "Currency", "TIV", "AAL", "Std Dev", "CV"]


def pull_top_locations(http: Http, c: Creds, analysis_id: str, account: str, edm_exposure_id: str,
                       dbg: list, all_locs: list | None = None, log: Log = _noop):
    """-> (layer, rows[19 cols] ). A 'no data' placeholder row mirrors the VBA."""
    meta = fetch_meta(http, c, analysis_id)
    if not meta:
        dbg.append([len(dbg) + 1, analysis_id, "", "", "META", 0, f"{riskdata_base(c)}/analyses/{analysis_id}", "", ""])
        return extract_layer(account), []
    name = gj(meta, "analysisName")
    exp_id = gj(meta, "exposureResourceId")
    cur = gj(gobj(meta, "currency"), "currencyCode")
    layer = extract_layer(name) if "PORTFOLIO:" in name.upper() else extract_layer(account)
    dbg.append([len(dbg) + 1, analysis_id, name, layer, "META", 200, f"{riskdata_base(c)}/analyses/{analysis_id}", "", exp_id])
    loc_exp = edm_exposure_id or exp_id
    if not loc_exp:
        return layer, [[layer, analysis_id, None, None, f"(no exposure ID resolved - see 'Top Locations Debug')"] + [None] * 14]
    url = (f"{riskdata_base(c)}/analyses/{analysis_id}/location-aal?perspectiveCode=GR"
           f"&sort=aal%20DESC&limit={TOPLOC_LIMIT}&offset=0")
    r = http.get(url, c.riskdata_key)
    dbg.append([len(dbg) + 1, analysis_id, name, layer, "AAL", r.status, url, r.text[:RESP_SNIPPET_LEN], exp_id])
    aal = _json(r.text) if r.status == 200 else None
    if not isinstance(aal, list):
        return layer, [[layer, analysis_id, None, None,
                        "(no Location AAL data returned - see 'Top Locations Debug')"] + [None] * 14]
    if all_locs is None:
        all_locs = fetch_all_locations(http, c, loc_exp, log)
    dmap = build_location_detail_map(all_locs)
    rows = []
    for i, item in enumerate(aal[:TOPLOC_LIMIT], start=1):
        lid = gj(item, "locationId")
        row = [None] * 19
        row[0], row[1], row[2], row[3] = layer, analysis_id, i, lid
        row[4], row[5] = gj(item, "locationName"), gj(item, "locationNumber")
        row[14] = cur
        row[16], row[17], row[18] = gv(item, "aal"), gv(item, "stdDev"), gv(item, "cv")
        det = dmap.get(lid)
        if det:
            if det[0]:
                row[4] = det[0]
            if det[1]:
                row[5] = det[1]
            row[6:14] = list(det[2:10])
            tiv = det[10]
            if tiv == 0:
                tiv = location_tiv_from_detail(http, c, loc_exp, lid)
            row[15] = tiv
        rows.append(row)
    return layer, rows


