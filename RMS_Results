def safe_get(obj, key: str, child: str | None = None):
    """LH_SafeGet, bug-for-bug: '' -> 0, missing -> None (blank), missing parent -> 0."""
    if not isinstance(obj, dict):
        return 0

    def leaf(d, k):
        if k not in d:
            return None
        v = d[k]
        if v is None:
            return None
        if isinstance(v, str):
            return 0 if v == "" else v
        return v

    if child is None:
        return leaf(obj, key)
    tmp = obj.get(key)
    if not isinstance(tmp, dict):
        return 0
    return leaf(tmp, child)


def _is_blank(v) -> bool:
    """LH_IsBlankVal"""
    if v is None:
        return True
    n = to_num(v)
    if n is not None:
        return n == 0
    return len(str(v).strip()) == 0


def proper_case(txt: str) -> str:
    t = txt.strip()
    if not t:
        return ""
    return " ".join(w[:1].upper() + w[1:] for w in t.lower().split(" ") if w != "")


def get_cresta(addr: dict):
    """LH_GetCresta"""
    for k, ch in (("zone1", None), ("zone1Code", None), ("zone", "name"), ("zone", None),
                  ("area", "name"), ("zone1", "name"), ("zone1Name", None), ("cresta", None)):
        v = safe_get(addr, k, ch)
        if not _is_blank(v):
            return v
    return safe_get(addr, "cresta")


def get_admin1(addr: dict):
    """LH_GetAdmin1"""
    for k, ch in (("admin1Name", None), ("admin1", "name"), ("stateName", None), ("state", None)):
        v = safe_get(addr, k, ch)
        if not _is_blank(v):
            return v
    return safe_get(addr, "state")


def resolve_eqsl_flag(detail) -> str:
    """LH_GetEqslInsuranceObj + LH_ResolveEqslInsuranceFlag -> '1' / '0' / ''"""
    obj = None
    if isinstance(detail, dict):
        eq = detail.get("locationEqDetail")
        if isinstance(eq, dict) and isinstance(eq.get("eqslInsurance"), dict):
            obj = eq["eqslInsurance"]
        if obj is None:
            def find(n):
                if isinstance(n, dict):
                    if isinstance(n.get("eqslInsurance"), dict):
                        return n["eqslInsurance"]
                    for v in n.values():
                        r = find(v)
                        if r is not None:
                            return r
                elif isinstance(n, list):
                    for v in n:
                        r = find(v)
                        if r is not None:
                            return r
                return None
            obj = find(detail)
    if not isinstance(obj, dict):
        return ""
    combined = f"{gj(obj, 'code').strip().upper()}|{gj(obj, 'name').strip().upper()}"
    if "YES" in combined:
        return "1"
    if "NO" in combined:
        return "0"
    return ""


def year_band(y) -> str:
    n = to_num(y)
    if n is None:
        return "Unknown"
    if n == 9999:
        return "Unknown"
    if n >= 2020:
        return "2020-2030"
    if n >= 2010:
        return "2010-2020"
    if n >= 2000:
        return "2000-2010"
    if n >= 1990:
        return "1990-2000"
    return "Pre-1990"


def stories_band(s):
    n = to_num(s)
    if n is None:
        return "Unknown"
    if n >= 50:
        return "50+"          # PORT: VBA writes "'50+" - the leading ' is Excel's text prefix, not data
    if n >= 21:
        return "21-50"
    if n >= 11:
        return "11-20"
    if n >= 7:
        return "7-10"
    return int(n) if float(n).is_integer() else n


def _cstr(v) -> str:
    return _s(v) if not isinstance(v, str) else v


def build_location_row(lw: dict, detail, account: str, loc_fallback: dict) -> list:
    """One 37-column Locations row (LH_PullLocationsAndHazardsForAccount inner loop)."""
    loc = gobj(lw, "location")
    prop, addr = gobj(loc, "property"), gobj(loc, "address")
    o = [None] * 37
    o[0] = safe_get(prop, "locationNumber")
    o[1] = safe_get(prop, "locationName")
    o[2] = account
    o[3] = safe_get(prop, "accountId")
    tiv = safe_get(lw, "tiv")
    if tiv is None or tiv == "" or tiv == 0:
        t2 = safe_get(loc, "tiv")
        tiv = t2 if t2 is not None else tiv
    o[4] = to_num(tiv) or 0.0
    bldg = cont = bi = 0.0
    eqsl = ""
    if isinstance(detail, dict):
        bldg = to_num(detail.get("maxCvgBldgValuation")) or 0.0
        for cov in detail.get("locationCoverages") or []:
            lt = gj(cov, "lossType").lower()
            if lt == "contents":
                cont = to_num(gv(cov, "value")) or cont
            elif lt in ("bi", "business interruption"):
                bi = to_num(gv(cov, "value")) or bi
        eqsl = resolve_eqsl_flag(detail)
    o[5], o[6], o[7], o[8] = bldg, cont, bi, eqsl
    o[9] = strip_prefix(_cstr(safe_get(prop, "buildingClass", "name")))
    o[10] = safe_get(prop, "buildingClassScheme", "name")
    o[11] = safe_get(prop, "buildingClass", "code")
    o[12] = strip_prefix(_cstr(safe_get(prop, "occupancyType", "name")))
    o[13] = safe_get(prop, "occupancyTypeScheme", "name")
    o[14] = safe_get(prop, "occupancyType", "id")
    o[15] = safe_get(prop, "stories")
    o[16] = safe_get(prop, "yearBuilt")
    o[17] = safe_get(prop, "userText1")
    o[18] = safe_get(prop, "userText2")
    o[19] = safe_get(prop, "userId1")
    o[20] = safe_get(prop, "userId2")
    o[21] = safe_get(addr, "country", "name")
    o[22] = get_cresta(addr)
    o[23] = get_admin1(addr)
    if _is_blank(o[23]):
        key = f"{account.strip().upper()}|{_norm_locnum(o[0])}"
        code = loc_fallback.get(key, "")
        if code:
            o[23] = STATE_CODE_TO_NAME.get(code, code)
            if _is_blank(o[21]):
                o[21] = "United States"
    o[24] = safe_get(addr, "admin2Name")
    o[25] = safe_get(addr, "admin3Name")
    o[26] = safe_get(addr, "cityName")
    o[27] = safe_get(addr, "admin4Name")
    o[28] = _cstr(safe_get(addr, "postalCode"))      # PORT: kept as text so leading zeros survive
    o[29] = safe_get(addr, "streetAddress")
    o[30] = safe_get(addr, "latitude")
    o[31] = safe_get(addr, "longitude")
    o[32] = safe_get(addr, "geoResolutionCode", "name")
    perils = prop.get("perils")
    o[33] = ", ".join(str(p) for p in perils) if isinstance(perils, list) else ""
    o[34] = year_band(o[16])
    o[35] = stories_band(o[15])
    o[36] = f"{_cstr(o[30])},{_cstr(o[31])}"
    return o


def _norm_locnum(v) -> str:
    n = to_num(v)
    return str(int(round(n))) if n is not None else str(v).strip()


# ---- hazard calls ----------------------------------------------------------
def _num_json(v) -> float:
    n = to_num(v)
    return n if n is not None else 0.0


def _code(scheme, code) -> str:
    """LH_Code: 'ATC7' style"""
    sch = str(scheme or "").strip().upper()
    cd = str(code or "").strip()
    if sch in ("", "0"):
        sch = "ATC"
    if cd == "" or not _is_numeric_str(cd):
        cd = "0"
    else:
        cd = str(int(float(cd))) if float(cd).is_integer() else cd
    return sch + cd


def _result_val(j, key):
    """LH_ResultVal"""
    if not isinstance(j, dict):
        return "Error"
    src = j
    if key not in j and "results" in j:
        res = j["results"]
        if isinstance(res, list):
            if res and isinstance(res[0], dict):
                src = res[0]
        elif isinstance(res, dict):
            src = res
    if key in src:
        return "N/A" if src[key] is None else src[key]
    if "code" in j or "message" in j:
        return "Error"
    return "N/A"


def _flood_val(j, key):
    """LH_FloodVal"""
    if isinstance(j, dict) and key in j and j[key] is not None and str(j[key]) != "":
        return j[key]
    return "N/A"


def _fema_zone(j) -> str:
    """LH_FemaZone"""
    if not isinstance(j, dict):
        return "Error"
    src = j
    if "floodZone" not in j and "results" in j:
        res = j["results"]
        if isinstance(res, list):
            if res and isinstance(res[0], dict):
                src = res[0]
        elif isinstance(res, dict):
            src = res
    if "floodZone" in src:
        z = src["floodZone"]
        return "Unmapped" if z is None or str(z).strip() == "" else str(z).strip()
    return "Error"


def hazard_lookups(http: Http, c: Creds, row: list) -> dict:
    """LH_AddHazardsForRowRange for ONE row (37-col list). -> {hazard header: value} ('' skip)."""
    out = {h: None for h in HAZARD_HEADERS}
    country = _cstr(row[21])
    if not country or country.upper() not in ("US", "UNITED STATES"):
        return out
    a1raw = _cstr(row[23]).strip()
    code = STATE_NAME_TO_CODE.get(proper_case(a1raw), "")
    if not code and len(a1raw) == 2 and a1raw.upper() in STATE_CODE_TO_NAME:
        code = a1raw.upper()
    lat, lon = row[30], row[31]
    if not code or str(lat).strip() == "" or str(lon).strip() == "" or lat is None or lon is None:
        return out
    base = f"https://{c.host}/li"
    key = c.hazard_key
    addr = {"countryScheme": "ISO2A", "countryCode": "US", "latitude": lat, "longitude": lon,
            "admin1Code": code, "countryRmsCode": "US", "rmsGeoModelResolutionCode": 1}

    def post(path, body):
        r = http.post(f"{base}/{path}/latest", key, json.dumps(body))
        return _json(r.text), r.text

    # EQ hazard
    j, _ = post("na_eq_hazard", {"location": {"address": addr}})
    if isinstance(j, dict):
        out["soilDescription"] = j.get("soilDescription", "N/A")
        out["liquefactionDescription"] = j.get("liquefactionDescription", "N/A")
        out["landslideDescription"] = j.get("landslideDescription", "N/A")
    else:
        out["soilDescription"] = out["liquefactionDescription"] = out["landslideDescription"] = "Error"
    # MMI
    j, _ = post("us_mmi", {"location": {"address": addr}})
    if isinstance(j, dict):
        if "mmi100yr" in j:
            mv = j["mmi100yr"]
            out["mmi100yr"] = mv
            n = to_num(mv)
            out["MMI_Description"] = MMI_DESC.get(int(round(n)), "Unknown") if n is not None else "Unknown"
        else:
            out["mmi100yr"] = out["MMI_Description"] = "N/A"
    else:
        out["mmi100yr"] = out["MMI_Description"] = "Error"
    # US flood depth
    j, _ = post("us_fl_depth", {"location": {"address": addr, "characteristics": {}, "coverageValues": {}},
                                "layerOptions": {"lookup": "floodDepth"}})
    if isinstance(j, dict) and ("status" in j or "depthInlandUndef100yr" in j):
        out["floodDepthUndef100yr"] = _flood_val(j, "depthInlandUndef100yr")
        out["floodDepthDef100yr"] = _flood_val(j, "depthInlandDef100yr")
        out["floodDepthUndef500yr"] = _flood_val(j, "depthInlandUndef500yr")
        out["floodDepthDef500yr"] = _flood_val(j, "depthInlandDef500yr")
    else:
        for h in ("floodDepthUndef100yr", "floodDepthDef100yr", "floodDepthUndef500yr", "floodDepthDef500yr"):
            out[h] = "Error"
    # FEMA zone
    j, _ = post("us_fema_firm", {"location": {"address": addr, "characteristics": {}, "coverageValues": {}}})
    out["floodZone"] = _fema_zone(j)
    # US flood risk score
    chars = {"construction": _code(row[10], row[11]), "occupancy": _code(row[13], row[14]),
             "yearBuilt": _num_json(row[16]), "numOfStories": _num_json(row[15])}
    cov = {"buildingValue": _num_json(row[5]), "contentsValue": _num_json(row[6]),
           "businessInterruptionValue": _num_json(row[7])}
    j, _ = post("us_fl_risk_score", {"location": {"address": addr, "characteristics": chars, "coverageValues": cov}})
    out["floodScoreOverall"] = _result_val(j, "scoreOverall")
    out["floodScore100yr"] = _result_val(j, "score100yr")
    out["floodScore250yr"] = _result_val(j, "score250yr")
    out["floodScore500yr"] = _result_val(j, "score500yr")
    # SubCresta (geocode zone1Code)
    gb = {"countryScheme": "ISO2A", "countryCode": "US", "admin1Code": code,
          "cityName": _cstr(row[26]).replace('"', "'"), "postalCode": _cstr(row[28]).replace('"', "'"),
          "streetAddress": _cstr(row[29]).replace('"', "'")}
    j, _ = post("geocode", gb)
    if isinstance(j, dict):
        z = safe_get(j, "zone1Code")
        out["SubCresta"] = "N/A" if _is_blank(z) else _cstr(z)
    else:
        out["SubCresta"] = "Error"
    return out


def pull_locations_and_hazards(http: Http, c: Creds, exposure_id: str, account: str,
                               loc_fallback: dict | None = None, do_hazard: bool = True,
                               all_locs: list | None = None, log: Log = _noop, workers: int = 4):
    """Port of LH_PullLocationsAndHazardsForAccount + hazards.
    -> (rows [dict header->value], map_rows). Only the highest accountId is kept (VBA maxAcct)."""
    loc_fallback = loc_fallback or {}
    if all_locs is None:
        all_locs = fetch_all_locations(http, c, exposure_id, log)
    if not all_locs:
        return [], []
    max_acct = -1.0
    for lw in all_locs:
        n = to_num(safe_get(gobj(gobj(lw, "location"), "property"), "accountId"))
        if n is not None and n > max_acct:
            max_acct = n
    keep = []
    for lw in all_locs:
        n = to_num(safe_get(gobj(gobj(lw, "location"), "property"), "accountId"))
        if n is not None and n == max_acct:
            keep.append(lw)
    log(f"{len(all_locs)} location(s) in EDM; {len(keep)} match highest accountId={max_acct:g}")

    def detail_for(lw):
        lid = _s(safe_get(gobj(gobj(lw, "location"), "property"), "locationId"))
        r = http.get(f"{riskdata_base(c)}/exposures/{exposure_id}/locations/{lid}", c.riskdata_key)
        return _json(r.text) if r.status == 200 else None

    with ThreadPoolExecutor(max_workers=workers) as pool:
        details = list(pool.map(detail_for, keep))
    rows37 = [build_location_row(lw, d, account, loc_fallback) for lw, d in zip(keep, details)]
    haz = [dict.fromkeys(HAZARD_HEADERS)] * len(rows37)
    if do_hazard and rows37:
        with ThreadPoolExecutor(max_workers=workers) as pool:
            haz = list(pool.map(lambda r: hazard_lookups(http, c, r), rows37))
    rows = []
    for r37, h in zip(rows37, haz):
        d = dict(zip(LOC_HEADERS, r37))
        d.update(h)
        rows.append(d)
    # Map sheet stats (LocID Count is never incremented in the VBA -> always 0)
    stats, seen = {}, {}
    for d in rows:
        mk = f"{_cstr(d['Latitude'])},{_cstr(d['Longitude'])}"
        if len(mk.strip()) > 1:
            if mk not in stats:
                stats[mk] = [d["Latitude"], d["Longitude"], mk, 0, 0.0]
                seen[mk] = set()
            lk = _cstr(d["LocID"])
            if lk and lk not in seen[mk]:
                seen[mk].add(lk)
                stats[mk][4] += d["Location TIV"] or 0.0
    return rows, list(stats.values())


