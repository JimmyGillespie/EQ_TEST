def clean_key(k: str) -> str:
    k = (k or "").strip()
    return k[7:].strip() if k.lower().startswith("bearer ") else k


@dataclass
class Creds:
    host: str
    riskdata_key: str
    riskmodeler_key: str
    grouping_key: str = ""
    hazard_key: str = ""
    grouping_resource_group_id: str = ""
    verify: bool = True

    def __post_init__(self):
        self.host = self.host.strip()
        self.riskdata_key = clean_key(self.riskdata_key)
        self.riskmodeler_key = clean_key(self.riskmodeler_key)
        self.grouping_key = clean_key(self.grouping_key)
        self.hazard_key = clean_key(self.hazard_key) or self.riskdata_key  # same value in the VBA
        self.grouping_resource_group_id = (self.grouping_resource_group_id or "").strip()


class Resp(NamedTuple):
    status: int
    text: str
    headers: dict


class Http:
    """Thin requests wrapper. One instance per run; thread-safe for simple GET/POST."""

    def __init__(self, verify: bool = True):
        self.verify = verify
        self.s = requests.Session()
        ad = HTTPAdapter(pool_connections=16, pool_maxsize=16)
        self.s.mount("https://", ad)
        self.s.mount("http://", ad)
        if not verify:
            try:
                import urllib3
                urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
            except Exception:
                pass

    def _do(self, method, url, key, body=None, headers=None, retries=3, timeout=(30, 120)):
        h = {"Accept": "application/json", "Authorization": key}
        if body is not None:
            h["Content-Type"] = "application/json"
        if headers:
            h.update(headers)
        last = ""
        for attempt in range(retries):
            try:
                r = self.s.request(method, url, headers=h, timeout=timeout, verify=self.verify,
                                   data=(body.encode("utf-8") if isinstance(body, str) else body))
                if r.status_code in (429, 502, 503, 504) and attempt < retries - 1:
                    time.sleep(min(2 ** (attempt + 1), 10))
                    continue
                return Resp(r.status_code, r.text, dict(r.headers))
            except requests.RequestException as exc:
                last = str(exc)
                if attempt < retries - 1:
                    time.sleep(min(2 ** (attempt + 1), 10))
        return Resp(0, f"{method} error: {last}", {})

    def get(self, url, key, headers=None):
        return self._do("GET", url, key, headers=headers)

    def post(self, url, key, body, headers=None):
        return self._do("POST", url, key, body=body, headers=headers)


# --------------------------------------------------------------------------
# Small helpers (ports of RP_GetJ / MI_GetJ / LH_SafeGet / etc.)
# --------------------------------------------------------------------------
def _s(v) -> str:
    """VBA CStr() for JSON scalars; '' for None / containers."""
    if v is None or isinstance(v, (dict, list)):
        return ""
    if isinstance(v, bool):
        return "True" if v else "False"
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v)


def gj(obj, key: str) -> str:
    """RP_GetJ / MI_GetJ: string value of key (case-insensitive), '' if absent."""
    if not isinstance(obj, dict):
        return ""
    if key in obj:
        return _s(obj[key])
    kl = key.lower()
    for k, v in obj.items():
        if str(k).lower() == kl:
            return _s(v)
    return ""


def gv(obj, key: str):
    """RP_GetV: raw value (case-insensitive) or None."""
    if not isinstance(obj, dict):
        return None
    if key in obj:
        return obj[key]
    kl = key.lower()
    for k, v in obj.items():
        if str(k).lower() == kl:
            return v
    return None


def gobj(obj, key: str) -> dict:
    """RP_GetObjCI: sub-object (case-insensitive) or {}."""
    v = gv(obj, key)
    return v if isinstance(v, dict) else {}


def to_num(v):
    """String/number -> float or None (what Excel does when a numeric string is written)."""
    if v is None or v == "":
        return None
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return float(v)
    try:
        return float(str(v).strip())
    except ValueError:
        return None


def _is_numeric_str(s: str) -> bool:
    try:
        float(s)
        return True
    except (TypeError, ValueError):
        return False


def _rp_key(v) -> str:
    try:
        f = float(v)
        return str(int(f)) if f.is_integer() else str(f)
    except (TypeError, ValueError):
        return str(v)


def extract_layer(analysis_name: str) -> str:
    """RP_ExtractLayer: text after 'PORTFOLIO:' up to the first '_'."""
    i = analysis_name.find("PORTFOLIO:")
    t = analysis_name[i + len("PORTFOLIO:"):].strip() if i >= 0 else analysis_name
    j = t.find("_")
    return t[:j] if j >= 0 else t


def strip_prefix(txt: str) -> str:
    """LH_StripPrefix / RP_StripPrefix: '1 - Wood Frame' -> 'Wood Frame' (2nd segment only)."""
    parts = txt.split(" - ")
    return parts[1] if len(parts) >= 2 else txt


def url_encode(s: str) -> str:
    """MI_UrlEncode: RFC3986, only A-Za-z0-9 - . _ ~ left as is."""
    return quote(s, safe="-._~")


def limit64(s: str) -> str:
    s = s.replace("\u2026", "").replace("...", "").strip()
    return s[:GROUP_NAME_MAXLEN]


def _as_list(parsed):
    if isinstance(parsed, list):
        return parsed
    if isinstance(parsed, dict):
        for k in ("items", "analyses", "data", "results"):
            if isinstance(parsed.get(k), list):
                return parsed[k]
    return []


def _json(text: str):
    try:
        return json.loads(text)
    except (ValueError, TypeError):
        return None


# --------------------------------------------------------------------------
# Analysis meta / EP / stats   (MI_FetchOneAnalysis + RP_PullEpForAnalysis)
# --------------------------------------------------------------------------
def riskdata_base(c: Creds) -> str:
    return f"https://{c.host}/platform/riskdata/v1"


def fetch_meta(http: Http, c: Creds, analysis_id: str):
    """GET platform/riskdata/v1/analyses/{id}; first element if a list; None on failure."""
    r = http.get(f"{riskdata_base(c)}/analyses/{analysis_id}", c.riskdata_key)
    if r.status != 200:
        return None
    p = _json(r.text)
    if isinstance(p, list):
        return p[0] if p and isinstance(p[0], dict) else None
    return p if isinstance(p, dict) else None


def parse_ep(text: str) -> dict:
    """-> {'AEP': [12 values|None], 'OEP': [...]} aligned to RP_LIST."""
    out = {}
    data = _json(text)
    if not isinstance(data, list):
        return out
    pos = {str(rp): i for i, rp in enumerate(RP_LIST)}
    for curve in data:
        ep_type = gj(curve, "epType")
        val = gv(curve, "value")
        rets = gv(val, "returnPeriods") if isinstance(val, dict) else None
        vals = gv(val, "positionValues") if isinstance(val, dict) else None
        if ep_type and isinstance(rets, list) and isinstance(vals, list):
            arr = [None] * len(RP_LIST)
            for j, rp in enumerate(rets):
                k = pos.get(_rp_key(rp))
                if k is not None and j < len(vals):
                    arr[k] = vals[j]
            out[ep_type] = arr
    return out


def parse_stats(text: str):
    """-> (purePremium, stdDev, cv) as floats / None."""
    p = _json(text)
    s2 = p[0] if isinstance(p, list) and p else (p if isinstance(p, dict) else None)
    if not isinstance(s2, dict):
        return (None, None, None)
    pp, sd, cv = gj(s2, "purePremium"), gj(s2, "totalStdDev"), gj(s2, "cv")
    if not pp:
        pp = gj(s2, "purePremiumAmount")
    if not sd:
        sd = gj(s2, "standardDeviation")
    if not cv:
        cv = gj(s2, "coefficientOfVariation")
    return (to_num(pp), to_num(sd), to_num(cv))


def currency_field(meta, key: str) -> str:
    return gj(gobj(meta, "currency"), key)


def fetch_analysis_data(http: Http, c: Creds, analysis_id: str,
                        perspectives=("GU", "GR", "RL"), meta=None):
    """Meta + EP + stats for one analysis. None if the meta fetch fails.
    Result shape == MI_FetchOneAnalysis / MI_FetchManyAnalyses (+ a few Meta-sheet fields)."""
    analysis_id = str(analysis_id)
    if meta is None:
        meta = fetch_meta(http, c, analysis_id)
    if not meta:
        return None
    exp_type = gj(meta, "exposureResourceType") or str(EXPOSURE_TYPE)
    exp_id = gj(meta, "exposureResourceId")
    base = f"{riskdata_base(c)}/analyses/{analysis_id}"
    jobs = []
    for p in perspectives:
        jobs.append((p, "ep", f"{base}/ep?exposureResourceType={exp_type}"
                              f"&exposureResourceId={exp_id}&perspectiveCode={p}"))
        jobs.append((p, "stats", f"{base}/stats?perspectiveCode={p}"
                                 f"&exposureResourceId={exp_id}&exposureResourceType={exp_type}"))
    with ThreadPoolExecutor(max_workers=6) as pool:
        resps = list(pool.map(lambda j: http.get(j[2], c.riskdata_key), jobs))
    ep_dict, stats_dict = {}, {}
    for (p, kind, _u), r in zip(jobs, resps):
        if kind == "ep":
            if r.status == 200 and r.text:
                for ep_type, arr in parse_ep(r.text).items():
                    ep_dict[f"{p}_{ep_type}"] = arr
        else:
            stats_dict[p] = parse_stats(r.text) if (r.status == 200 and r.text) else (None, None, None)
    return {
        "analysisId": analysis_id,
        "appAnalysisId": gj(meta, "appAnalysisId"),
        "portfolioName": gj(meta, "exposureName"),
        "exposureType": exp_type,
        "exposureID": exp_id,
        "analysisName": gj(meta, "analysisName"),
        "peril": gj(meta, "peril"),
        "perilCode": gj(meta, "perilCode"),
        "subPeril": gj(meta, "subPeril"),
        "region": gj(meta, "region"),
        "engineVersion": gj(meta, "engineVersion"),
        "lossAmplification": gj(meta, "lossAmplification"),
        "currencyCode": currency_field(meta, "currencyCode"),
        "currencyName": currency_field(meta, "currencyName"),
        "currencyVintage": currency_field(meta, "currencyVintage"),
        "currencyAsOf": currency_field(meta, "asOfDate"),
        "modelProfile": gj(gobj(meta, "modelProfile"), "name"),
        "outputProfile": gj(gobj(meta, "outputProfile"), "name"),
        "username": gj(meta, "username"),
        "description": gj(meta, "description"),
        "epDict": ep_dict,
        "statsDict": stats_dict,
    }


def meta_row(d: dict) -> list:
    """The 16 'Meta' columns exactly as RP_PullEpForAnalysis writes them."""
    return [d["analysisId"], d["analysisName"], d.get("layer", ""), d["peril"], d["region"],
            d["engineVersion"], d["lossAmplification"], d["currencyCode"], d["currencyName"],
