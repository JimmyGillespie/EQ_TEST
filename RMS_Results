def grouping_url(c: Creds) -> str:
    return f"https://{c.host}/platform/grouping/v1/jobs"


def _grouping_headers(c: Creds) -> dict:
    return {"x-rms-resource-group-id": c.grouping_resource_group_id}


def normalize_job_url(c: Creds, loc: str) -> str:
    loc = (loc or "").strip()
    if not loc:
        return ""
    if loc.lower().startswith("http"):
        return loc
    if loc.startswith("/"):
        return f"https://{c.host}{loc}"
    return f"https://{c.host}/{loc}"


def create_grouping_job(http: Http, c: Creds, portfolio_aid: str, quote_aid: str, layer: str,
                        cur_code: str, cur_vintage: str, cur_asof: str):
    """-> (ok, job_url, raw, group_name)"""
    group_name = limit64(f"MarginalImpact_{layer}_{portfolio_aid}_{quote_aid}")
    descr = (f"Marginal impact of Quote {quote_aid} on Portfolio {portfolio_aid} (layer {layer})")
    body = {
        "resourceType": "analyses",
        "resourceUris": [f"/platform/riskdata/v1/analyses/{portfolio_aid}",
                         f"/platform/riskdata/v1/analyses/{quote_aid}"],
        "settings": {
            "analysisName": group_name, "description": descr,
            "simulateToPLT": True, "propagateDetailedLosses": False, "numOfSimulations": 50000,
            "currency": {"code": cur_code, "scheme": "RMS", "vintage": cur_vintage, "asOfDate": cur_asof},
            "regionPerilSimulationSet": REGION_PERIL_SIM_SET,
        },
    }
    bj = json.dumps(body, separators=(",", ":"))
    r = http.post(grouping_url(c), c.grouping_key, bj, headers=_grouping_headers(c))
    loc = r.headers.get("Location") or r.headers.get("location") or ""
    raw = f"REQUEST: {bj}\nSTATUS: {r.status}\nRESPONSE: {r.text}\nLOCATION HEADER: {loc}"
    if not (200 <= r.status < 300):
        return False, "", raw, group_name
    url = normalize_job_url(c, loc)
    return bool(url), url, raw, group_name


def poll_grouping_job(http: Http, c: Creds, job_url: str):
    """One poll -> (status_word, raw_text). status_word in FINISHED/FAILED/CANCELLED/CANCELED or other."""
    r = http.get(job_url, c.grouping_key, headers=_grouping_headers(c))
    st = "UNKNOWN"
    if r.status == 200:
        p = _json(r.text)
        if isinstance(p, dict) and "status" in p:
            st = str(p["status"]).upper()
    return st, r.text


def extract_grouped_analysis_id(resp_text: str, exclude1: str, exclude2: str) -> str:
    """MI_ExtractGroupedAnalysisId (last non-input numeric trailing segment wins)."""
    best = ""
    p = _json(resp_text)
    res = gobj(p, "details").get("resources") if isinstance(p, dict) else None
    if isinstance(res, list):
        for it in res:
            uri = gj(it, "uri")
            if uri:
                cand = uri.split("/")[-1].strip()
                if cand.isdigit() and cand not in (exclude1, exclude2):
                    best = cand
    return best


