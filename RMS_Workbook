def write_meta(wb, rows):
    ws = wb.create_sheet("Meta")
    for c, h in enumerate(META_HEADERS, 1):
        ws.cell(1, c, h)
    for r, row in enumerate(rows, 2):
        for c, v in enumerate(row, 1):
            ws.cell(r, c, xl(v) if v not in ("", None) else None)
    _autofit(ws, 1, 4)
    return ws


def write_rds_events(wb, rds_cols):
    ws = wb.create_sheet("RDS Events")
    ws.cell(1, 1, "Eventid")
    ws.cell(1, 2, "EventName")
    for i, (eid, name) in enumerate(EVENT_MAP.items()):
        ws.cell(2 + i, 1, xl(eid))
        ws.cell(2 + i, 2, name)
    col = 3
    bold_rows = set()
    for hdr, vals in rds_cols.items():
        ws.cell(1, col, hdr)
        for i, eid in enumerate(EVENT_MAP):
            if eid in vals and vals[eid] > 0:
                ws.cell(2 + i, col, vals[eid])
                bold_rows.add(2 + i)
        col += 1
    last_col = max(col - 1, 2)
    last_row = 1 + len(EVENT_MAP)
    for r in bold_rows:
        for c in range(1, last_col + 1):
            ws.cell(r, c).font = Font(bold=True)
    for c in range(1, last_col + 1):
        cell = ws.cell(1, c)
        cell.font = Font(bold=True, color="FFFFFF")
        cell.fill = _fill(BLUE)
    for r in range(2, last_row + 1):
        for c in range(3, last_col + 1):
            ws.cell(r, c).number_format = "#,##0"
    _thin_borders(ws, 1, 1, last_row, last_col)
    for r in range(2, last_row + 1):
        if r % 2 == 0:
            for c in range(1, last_col + 1):
                ws.cell(r, c).fill = _fill(ZEBRA)
    _autofit(ws, 1, last_col)
    return ws


DBG_HEADERS = ["Row", "AnalysisID", "AnalysisName", "Layer", "Perspective", "Status", "URL",
