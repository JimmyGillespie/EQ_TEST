def write_debug(wb, name, rows, bold_header=False):
    ws = wb.create_sheet(name)
    for c, h in enumerate(DBG_HEADERS, 1):
        cell = ws.cell(1, c, h)
        if bold_header:
            cell.font = Font(bold=True)
    for r, row in enumerate(rows, 2):
        for c, v in enumerate(row, 1):
            ws.cell(r, c, xl(v) if v not in ("", None) else None)
    return ws


def write_top_locations(wb, blocks):
    ws = wb.create_sheet("Top Locations")
    for c, h in enumerate(TOPLOC_HEADERS, 1):
        ws.cell(1, c, h).font = Font(bold=True)
    r = 2
    for layer, rows in blocks:
        if r > 2:
            r += 1
        ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=19)
        t = ws.cell(r, 1, f"Layer: {layer}")
        t.font = Font(bold=True)
        t.fill = _fill(GREY)
        r += 1
        for row in rows:
            for c, v in enumerate(row, 1):
                ws.cell(r, c, xl(v) if v not in ("", None) else None)
            r += 1
    last = ws.max_row
    for c in range(1, 20):
        cell = ws.cell(1, c)
        cell.font = Font(bold=True, color="FFFFFF")
        cell.fill = _fill(BLUE)
    for rr in range(2, last + 1):
        for c in range(16, 20):
            ws.cell(rr, c).number_format = "#,##0"
    _autofit(ws, 1, 19)
    _thin_borders(ws, 1, 1, last, 19)
    for rr in range(2, last + 1):
        if rr % 2 == 0:
            for c in range(1, 20):
                ws.cell(rr, c).fill = _fill(ZEBRA)
    return ws


