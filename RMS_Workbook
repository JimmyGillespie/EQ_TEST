def _cs(v) -> str:
    if v is None:
        return ""
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v).strip()


def _category_rows(locs, header):
    """RS_GetCategoryRowsFromLocations -> [(label, count, tiv)] in first-seen order."""
    if not locs or header not in locs[0] or "Location TIV" not in locs[0]:
        return []
    acc = {}
    for d in locs:
        lbl = _cs(d.get(header))
        if lbl == "":
            lbl = "Unknown"
        tiv = _num(d.get("Location TIV"))
        k = lbl.lower()
        if k in acc:
            acc[k][1] += 1
            acc[k][2] += tiv
        else:
            acc[k] = [lbl, 1, tiv]
    return [tuple(v) for v in acc.values()]


def _stories_rows(locs):
    """RS_GetStoriesBandRows"""
    if not locs or "# of Stories" not in locs[0]:
        return []
    acc = {}
    for d in locs:
        n = to_num(d.get("# of Stories"))
        if n is None or n <= 0:
            band = "Unknown"
        elif n <= 2:
            band = "1-2"
        elif n <= 5:
            band = "3-5"
        elif n <= 10:
            band = "6-10"
        else:
            band = ">10"
        tiv = _num(d.get("Location TIV"))
        if band in acc:
            acc[band][1] += 1
            acc[band][2] += tiv
        else:
            acc[band] = [band, 1, tiv]
    return [tuple(v) for v in acc.values()]


def _find_catch_all(order):
    for i, o in enumerate(order):
        if o.strip().lower() in ("unknown", "other"):
            return i
    return -1


def _order_with_extras(order, rows):
    known = {o.strip().lower() for o in order}
    extras = []
    for lbl, _c, _t in rows:
        lbl = lbl.strip()
        if lbl and lbl.lower() not in known:
            known.add(lbl.lower())
            extras.append(lbl)
    if not extras:
        return list(order)
    cidx = _find_catch_all(order)
    out = []
    for i, o in enumerate(order):
        if i == cidx:
            out.extend(extras)
        out.append(o)
    if cidx == -1:
        out.extend(extras)
    return out


def _in_list(lbl, lst):
    return lbl.strip().lower() in {x.strip().lower() for x in lst}


def _hazard_tier(lbl, red, amber, green):
    if _in_list(lbl, UNKNOWN_LEVELS):
        return "PINK"
    if _in_list(lbl, red):
        return "RED"
    if _in_list(lbl, amber):
        return "AMBER"
    if _in_list(lbl, green):
        return "GREEN"          # HAZ_SHOW_GREEN = True
    return "PINK"               # label in no list at all -> shown pink so it gets noticed


class _RS:
    def __init__(self, ws, locs):
        self.ws, self.locs = ws, locs

    # -- drawing helpers ------------------------------------------------
    def banner(self, r, text):
        for c in range(1, BANNER_LAST_COL + 1):
            cell = self.ws.cell(r, c)
            cell.fill = _fill(CLR_BANNER)
            cell.font = Font(bold=True, color="FFFFFF", size=12)
        self.ws.cell(r, 1, text)

    def box(self, r1, c1, r2, c2):
        if r2 < r1 or c2 < c1:
            return
        hair = Side(style="hair", color="BFBFBF")
        thin = Side(style="thin", color="595959")
        for r in range(r1, r2 + 1):
            for c in range(c1, c2 + 1):
                self.ws.cell(r, c).border = Border(
                    left=thin if c == c1 else hair, right=thin if c == c2 else hair,
                    top=thin if r == r1 else hair, bottom=thin if r == r2 else hair)

    def title3(self, r, c, title):
        ws = self.ws
        ws.cell(r, c, title)
        ws.cell(r, c + 1, "Loc Count")
        ws.cell(r, c + 2, "TIV")
        for k in range(3):
            ws.cell(r, c + k).font = Font(bold=True)
            ws.cell(r, c + k).fill = _fill(CLR_SECTION)

    def row3(self, r, c, label, cnt, tiv, bold=False):
        ws = self.ws
        ws.cell(r, c).number_format = "@"
        ws.cell(r, c, label)
        ws.cell(r, c + 1, cnt)
        ws.cell(r, c + 2, tiv).number_format = TIV_FMT
        if bold:
            for k in range(3):
                ws.cell(r, c + k).font = Font(bold=True)

    # -- blocks ---------------------------------------------------------
    def breakdown(self, r0, c, title, rows, order, add_extras=False):
        """RS_WriteBreakdownBlock(Loc) / RS_WriteStoriesBlock. Returns next free row."""
        self.title3(r0, c, title)
        r = r0 + 1
        d1 = {}
        for lbl, cnt, tiv in rows:
            d1.setdefault(lbl.strip().lower(), (cnt, tiv))
        use = _order_with_extras(order, rows) if add_extras else list(order)
        if not use:
            use = list(d1.keys())
        matched = {u.lower() for u in use}
        left_c = sum(v[0] for k, v in d1.items() if k not in matched)
        left_t = sum(v[1] for k, v in d1.items() if k not in matched)
        cidx = _find_catch_all(use)
        tc = tt = 0.0
        for i, lab in enumerate(use):
            cnt, tiv = d1.get(lab.lower(), (0, 0.0))
            if i == cidx:
                cnt, tiv = cnt + left_c, tiv + left_t
            self.row3(r, c, lab, cnt, tiv)
            tc, tt = tc + cnt, tt + tiv
            r += 1
        if cidx == -1 and (left_c != 0 or left_t != 0):
            self.row3(r, c, "Other", left_c, left_t)
            tc, tt = tc + left_c, tt + left_t
            r += 1
        self.row3(r, c, "Grand Total", tc, tt, bold=True)
        self.box(r0, c, r, c + 2)
        return r + 1

    def top5(self, r0, c, title, rows):
        """RS_WriteTop5Block(Loc)"""
        self.title3(r0, c, title)
        r = r0 + 1
        top = sorted(rows, key=lambda x: -_num(x[2]))[:TOP_N]       # stable, descending by TIV
        tc = tt = 0.0
        for i in range(TOP_N):
            if i < len(top):
                self.row3(r, c, top[i][0], top[i][1], top[i][2])
                tc, tt = tc + _num(top[i][1]), tt + _num(top[i][2])
            else:
                self.ws.cell(r, c + 2).number_format = TIV_FMT
            r += 1
        self.row3(r, c, "Total (All Categories)", tc, tt, bold=True)
        self.box(r0, c, r, c + 2)
        return r + 1

    def hazard_block(self, r0, c, title, value_hdr, header):
        """RS_WriteHazardBlock (flood)"""
        ws = self.ws
        ws.cell(r0, c, title).font = Font(bold=True)
        r = r0 + 1
        ws.cell(r, c, value_hdr)
        ws.cell(r, c + 1, "Loc Count")
        ws.cell(r, c + 2, "TIV")
        for k in range(3):
            ws.cell(r, c + k).font = Font(bold=True)
            ws.cell(r, c + k).fill = _fill(CLR_SECTION)
        rows = _category_rows(self.locs, header)
        tc = tt = 0.0
        if not rows:
            r += 1
            ws.cell(r, c, f"No data ({header} not found on Locations)")
        else:
            def rank(s):
                if to_num(s) is not None:
                    return 0
                return 2 if s.strip().lower() in ("unmapped", "unknown", "n/a", "error", "not looked up") else 1

            def less_key(x):
                s = x[0]
                rk = rank(s)
                return (rk, to_num(s) if rk == 0 else 0, s.lower() if rk != 0 else "")

            for lbl, cnt, tiv in sorted(rows, key=less_key):
                r += 1
                cell = ws.cell(r, c)
                cell.number_format = "@"
                cell.value = lbl
                cell.alignment = Alignment(horizontal="left")
                ws.cell(r, c + 1, cnt)
                ws.cell(r, c + 2, tiv).number_format = TIV_FMT
                tc, tt = tc + cnt, tt + tiv
        r += 1
        ws.cell(r, c, "Grand Total")
        ws.cell(r, c + 1, tc)
        ws.cell(r, c + 2, tt).number_format = TIV_FMT
        for k in range(3):
            ws.cell(r, c + k).font = Font(bold=True)
        self.box(r0 + 1, c, r, c + 2)
        return r + 1

    def apply_hazard_cf(self, first, last, c, red, amber, green):
        """RS_ApplyHazardCF: one rule per data row, only lit while Loc Count > 0."""
        if last < first:
            return
        ws = self.ws
        for r in range(first, last + 1):
            tier = _hazard_tier(_cs(ws.cell(r, c).value), red, amber, green)
            cnt = f"${get_column_letter(c + 1)}${r}"
            rng = f"{get_column_letter(c)}{r}:{get_column_letter(c + 2)}{r}"
            if tier == "RED":
                font, fill = Font(bold=True, color="9C0006"), _fill("FFC7CE")
            elif tier == "AMBER":
                font, fill = Font(color="9C5700"), _fill("FFD966")
            elif tier == "GREEN":
                font, fill = Font(color="006100"), _fill("C6EFCE")
            else:
                font, fill = Font(bold=True, color="99004C"), _fill("FF99CC")
            ws.conditional_formatting.add(rng, FormulaRule(formula=[f"{cnt}>0"], font=font, fill=fill))

    def flood_key(self, r):
        ws = self.ws
        ws.cell(r, 1, "What the flood hazard fields mean").font = Font(bold=True)
        r += 1
        start = r
        ws.cell(r, 1, "Field")
        ws.cell(r, 2, "Short explanation")
        for c in range(1, BANNER_LAST_COL + 1):
            ws.cell(r, c).font = Font(bold=True)
            ws.cell(r, c).fill = _fill(CLR_SECTION)
        for name, text in FLOOD_KEY_ITEMS:
            r += 1
            ws.cell(r, 1, name).font = Font(bold=True)
            ws.cell(r, 2, text)
            ws.merge_cells(start_row=r, start_column=2, end_row=r, end_column=BANNER_LAST_COL)
            ws.cell(r, 2).alignment = Alignment(horizontal="left")
        ws.merge_cells(start_row=start, start_column=2, end_row=start, end_column=BANNER_LAST_COL)
        ws.cell(start, 2).alignment = Alignment(horizontal="left")
        self.box(start, 1, r, BANNER_LAST_COL)
        r += 1
        c = ws.cell(r, 1, "Source: Moody's RMS Location Intelligence (FEMA flood zone, US Flood Depth, "
                          "US Flood Risk Score), looked up for each location on the Locations sheet.")
        c.font = Font(italic=True, size=9)
        return r + 2


def layer_summary_rows(bundle) -> list:
    """What the layer tab + RDS Events feed into 'Layer Statistics'."""
    rows = []
    mi = bundle.get("mi")
    k250 = RP_LIST.index(TARGET_RP)
    for e in bundle["analyses"]:
        layer = e["layer"]
        pp = e["data"]["statsDict"].get("GR", (None,))[0]
        row = {"layer": layer, "pure_prem": _num(pp), "portfolio": 0.0, "quote": 0.0, "grouped": 0.0,
               "marginal": 0.0, "impact": 0.0}
        if mi and mi["layer"] == layer:
            def at(d):
                a = d["epDict"].get("GR_OEP")
                return _num(a[k250]) if a else 0.0
            row["portfolio"], row["quote"], row["grouped"] = at(mi["portfolio"]), at(mi["quote"]), at(mi["grouped"])
            row["marginal"] = row["grouped"] - row["portfolio"]
            # ASSUMPTION: 'Impact %' on the template = Marginal / Portfolio (0 when Portfolio is 0)
            row["impact"] = row["marginal"] / row["portfolio"] if row["portfolio"] else 0.0
        vals = bundle["rds_cols"].get(f"{layer}_GR", {})
        by_name = {EVENT_MAP[k]: v for k, v in vals.items() if k in EVENT_MAP}
        row["rds"] = [_num(by_name.get(n)) for n in RDS_EVENTS]
        rows.append(row)
    return rows


def write_report_summary(wb, bundle, now=None):
    now = now or datetime.now()
    ws = wb.create_sheet("Report Summary")
    locs = bundle.get("locations") or []
    layer_rows = layer_summary_rows(bundle)
    rs = _RS(ws, locs)

    ws["A1"] = "AMTRUST GROUP"
    ws["A1"].font = Font(size=20, bold=True)
    ws["A2"] = "Report Summary"
    ws["A2"].font = Font(size=16, italic=True)
    ws["F2"] = "Report generated: " + now.strftime("%d/%m/%Y %H:%M")
    ws["F2"].font = Font(italic=True)

    # ---- Layer Statistics --------------------------------------------------
    r = 4
    rs.banner(r, "Layer Statistics (EQ, Gross Perspective)")
    r += 1
    hdr = r
    cRP, cLB, cP, cQ, cG, cM, cI = 6, 7, 8, 9, 10, 11, 12
    cRL, cE1, cE2, cE3 = 14, 15, 16, 17
    ws.cell(r, 1, "Layer")
    ws.cell(r, 2, "Pure Premium")
    ws.cell(r, cRP, "Return Period ( OEP )")
    ws.cell(r, cP, "Portfolio")
    ws.cell(r, cQ, "Quote")
    ws.cell(r, cG, "Quote + Portfolio")
    ws.cell(r, cM, "Marginal Impact")
    ws.cell(r, cI, "Impact %")
    ws.cell(r, cRL, "RDS")
    for k, ev in enumerate(RDS_EVENTS):
        ws.cell(r, cE1 + k, ev)
    for a, b in ((1, 2), (cRP, cI), (cRL, cE3)):
        for c in range(a, b + 1):
            ws.cell(r, c).font = Font(bold=True, color="FFFFFF")
            ws.cell(r, c).fill = _fill(CLR_BANNER)
    first = r + 1
    r = first
    total_pp = 0.0
    if not layer_rows:
        ws.cell(r, 1, "No layer tabs found - check Controls!D or 'Loss Overview' marker.")
    else:
        for i, lr in enumerate(layer_rows):
            ws.cell(r, 1, lr["layer"])
            ws.cell(r, 2, lr["pure_prem"])
            if r == first:
                ws.cell(r, cRP, TARGET_RP)
            ws.cell(r, cLB, lr["layer"])
            ws.cell(r, cP, lr["portfolio"])
            ws.cell(r, cQ, lr["quote"])
            ws.cell(r, cG, lr["grouped"])
            ws.cell(r, cM, lr["marginal"])
            ws.cell(r, cI, lr["impact"])
            ws.cell(r, cRL, lr["layer"])
            for k in range(3):
                ws.cell(r, cE1 + k, lr["rds"][k])
            total_pp += lr["pure_prem"]
            r += 1
        last = r - 1
        total_row = r
        ws.cell(r, 1, "Total").font = Font(bold=True)
        ws.cell(r, 2, total_pp).font = Font(bold=True)
        r += 1
        ws.cell(r, 1, "Note: sourced directly from each layer tab's own Statistics block (GR perspective, EQ peril); "
                      "RDS losses sourced from 'RDS Events'.").font = Font(italic=True)
        for rr in range(first, total_row + 1):
            ws.cell(rr, 2).number_format = "#,##0"
        for rr in range(first, last + 1):
            for c in (cP, cQ, cG, cM, cE1, cE2, cE3):
                ws.cell(rr, c).number_format = "#,##0"
            ws.cell(rr, cI).number_format = "0.00%"
        rs.box(hdr, 1, total_row, 2)
        rs.box(hdr, cRP, last, cI)
        rs.box(hdr, cRL, last, cE3)
    r = r + 1          # RS_WriteLayerStatistics returns r+1, caller adds 1 more
    r = r + 1

    # ---- Exposure Summary --------------------------------------------------
    rs.banner(r, "Exposure Summary")
    r += 2
    total_tiv = sum(_num(d.get("Location TIV")) for d in locs)
    ws.cell(r, 1, "Total TIV (USD)").font = Font(bold=True)
    ws.cell(r, 2, total_tiv).number_format = "#,##0"
    ws.cell(r + 1, 1, "Locations Count").font = Font(bold=True)
    ws.cell(r + 1, 2, len(locs)).number_format = "#,##0"
    ws.cell(r + 2, 1, "Layers Modelled").font = Font(bold=True)
    ws.cell(r + 2, 2, len(layer_rows))
    ws.cell(r + 3, 1, "Peril Modelled").font = Font(bold=True)
    ws.cell(r + 3, 2, "EQ")
    metrics_next = r + 4
    rs.box(r, 1, r + 3, 2)
    res_next = rs.breakdown(r, COL2, "Resolution", _category_rows(locs, "Geocoding Resolution"), RESOLUTION_ORDER)
    cty_next = rs.top5(r, COL3, "Top 5 County by TIV", _category_rows(locs, "Admin2"))
    cst_next = rs.top5(r, COL4, "Top 5 CRESTA by TIV", _category_rows(locs, "CRESTA"))
    r = max(metrics_next, res_next, cty_next, cst_next) + 3

    occ_next = rs.top5(r, COL1, "Top 5 Occupancy by TIV", _category_rows(locs, "Occupancy Name"))
    con_next = rs.top5(r, COL2, "Top 5 Construction by TIV", _category_rows(locs, "Construction Name"))
    sto_next = rs.breakdown(r, COL3, "Stories", _stories_rows(locs), STORIES_ORDER)
    yr_next = rs.breakdown(r, COL4, "Year Built", _category_rows(locs, "Year Built Band"), YEAR_ORDER)
    r = max(occ_next, con_next, sto_next, yr_next)

    rs.banner(r, "Hazard Summary")
    r += 2
    liq = rs.breakdown(r, COL1, "Liquefaction", _category_rows(locs, "liquefactionDescription"),
                       HAZ_LEVEL_ORDER, add_extras=True)
    rs.apply_hazard_cf(r + 1, liq - 2, COL1, HAZ_RED, HAZ_AMBER, HAZ_GREEN)
    lan = rs.breakdown(r, COL2, "Landslide", _category_rows(locs, "landslideDescription"),
                       HAZ_LEVEL_ORDER, add_extras=True)
    rs.apply_hazard_cf(r + 1, lan - 2, COL2, HAZ_RED, HAZ_AMBER, HAZ_GREEN)
    soi = rs.breakdown(r, COL3, "Soil Description", _category_rows(locs, "soilDescription"),
                       SOIL_ORDER, add_extras=True)
    rs.apply_hazard_cf(r + 1, soi - 2, COL3, SOIL_RED, SOIL_AMBER, SOIL_GREEN)
    r = max(liq, lan, soi) + 1

    rs.banner(r, "Hazard Summary (Flood)")
    r += 2
    h = [rs.hazard_block(r, COL1, "FEMA Flood Zone", "Zone", "floodZone"),
         rs.hazard_block(r, COL2, "Flood Score - Overall", "Score", "floodScoreOverall"),
         rs.hazard_block(r, COL3, "Flood Score - 1 in 100", "Score", "floodScore100yr"),
         rs.hazard_block(r, COL4, "Flood Score - 1 in 250", "Score", "floodScore250yr"),
         rs.hazard_block(r, COL5, "Flood Score - 1 in 500", "Score", "floodScore500yr")]
    r = max(h) + 1
    h = [rs.hazard_block(r, COL1, "Depth Band - 1 in 100, Undefended", "Band", "floodDepthUndef100yr"),
         rs.hazard_block(r, COL2, "Depth Band - 1 in 100, Defended", "Band", "floodDepthDef100yr"),
         rs.hazard_block(r, COL3, "Depth Band - 1 in 500, Undefended", "Band", "floodDepthUndef500yr"),
         rs.hazard_block(r, COL4, "Depth Band - 1 in 500, Defended", "Band", "floodDepthDef500yr")]
    r = max(h) + 1
    rs.flood_key(r)

    # RS_FormatReportSheet
    _autofit(ws, 2, 21, skip_cols=(), cap=40)
    ws.column_dimensions["A"].width = 26
    ws.sheet_properties.tabColor = BLUE
    ws.sheet_view.showGridLines = False
    return ws


# ===========================================================================
def build_workbook(bundle: dict, now: datetime | None = None) -> bytes:
    wb = Workbook()
    wb.remove(wb.active)
    write_report_summary(wb, bundle, now)
    write_results(wb, bundle["analyses"])
    if bundle.get("mi"):
        write_marginal_impact(wb, bundle["mi"])
    write_meta(wb, bundle["meta_rows"])
    write_rds_events(wb, bundle["rds_cols"])
    write_debug(wb, "RDS Debug", bundle["rds_dbg"])
    if bundle["toploc_blocks"]:
        write_top_locations(wb, bundle["toploc_blocks"])
        write_debug(wb, "Top Locations Debug", bundle["toploc_dbg"], bold_header=True)
    if bundle.get("locations"):
        write_locations(wb, bundle["locations"])
        write_map(wb, bundle["map_rows"])
    buf = BytesIO()
    wb.save(buf)
    return buf.getvalue()
