def write_results(wb, entries):
    ws = wb.create_sheet("Results")
    base = 5
    ws.cell(1, 1, "Grouping ID:")
    ws.cell(2, 1, "Index 1")
    ws.cell(3, 1, "Index 2")
    for i, lab in enumerate(["Portfolio Name:", "Portfolio ID", "Analysis Name:", "Layer:", "Analysis ID:",
                             "Peril:", "Peril Code:", "Subperil:", "Perspective:", "EP Type"]):
        ws.cell(base + i, 1, lab)
    for ii, rp in enumerate(RP_LIST):
        ws.cell(base + 10 + ii, 1, rp)
    n = len(RP_LIST)
    ws.cell(base + 10 + n, 1, "Pure Premium:")
    ws.cell(base + 10 + n + 1, 1, "Std Dev:")
    ws.cell(base + 10 + n + 2, 1, "CV:")
    col = 2
    for e in entries:
        d, layer = e["data"], e["layer"]
        for p in ("GU", "GR"):
            pp, sd, cv = d["statsDict"].get(p, (None, None, None))
            for ep in ("AEP", "OEP"):
                arr = d["epDict"].get(f"{p}_{ep}")
                if arr is None:
                    continue
                if e.get("grouping_id") not in (None, ""):
                    ws.cell(1, col, e["grouping_id"])
                ws.cell(2, col, f"{p}_{ep}_{d['perilCode']}_{layer}")
                ws.cell(3, col, f"{p}_{ep}_{d['perilCode']}_{d['analysisId']}_{layer}")
                vals = [d["portfolioName"], d["exposureID"], d["analysisName"], layer, d["analysisId"],
                        d["peril"], d["perilCode"], d["subPeril"], p, ep]
                for i, v in enumerate(vals):
                    ws.cell(base + i, col, xl(v) if v != "" else None)
                for ii, v in enumerate(arr):
                    ws.cell(base + 10 + ii, col, v)
                ws.cell(base + 10 + n, col, pp)
                ws.cell(base + 10 + n + 1, col, sd)
                ws.cell(base + 10 + n + 2, col, cv)
                col += 1
    _autofit(ws, 1, max(col - 1, 1))
    return ws


