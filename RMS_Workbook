_NUM_RE = re.compile(r"^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$")


def xl(v):
    """What Excel does when a numeric-looking STRING is assigned to a cell."""
    if isinstance(v, str):
        s = v.strip()
        if s and _NUM_RE.match(s):
            f = float(s)
            return int(f) if f.is_integer() and "." not in s and "e" not in s.lower() else f
    return v


def vba_rgb(n: int) -> str:
    """VBA Long colour (BGR) -> 'RRGGBB'."""
    return f"{n & 255:02X}{(n >> 8) & 255:02X}{(n >> 16) & 255:02X}"


GREY = "D9D9D9"
BLUE = "0066CC"
ZEBRA = "F2F2F2"
CLR_BANNER = vba_rgb(8465185)     # navy
CLR_SECTION = vba_rgb(15987699)   # light grey/blue

TIV_FMT = '#,##0;(#,##0);"-"'


def _fill(rgb):
    return PatternFill(start_color=rgb, end_color=rgb, fill_type="solid")


def _autofit(ws, first_col=1, last_col=None, cap=80, skip_cols=(), min_w=8.43):
    last_col = last_col or ws.max_column
    merged = set()
    for rng in ws.merged_cells.ranges:
        for row in ws.iter_rows(min_row=rng.min_row, max_row=rng.max_row,
                                min_col=rng.min_col, max_col=rng.max_col):
            for cell in row:
                merged.add(cell.coordinate)
    for c in range(first_col, last_col + 1):
        if c in skip_cols:
            continue
        w = 0
        for row in ws.iter_rows(min_col=c, max_col=c):
            cell = row[0]
            if cell.value is None or cell.coordinate in merged:
                continue
            v = cell.value
            if isinstance(v, float) or isinstance(v, int):
                n = len(f"{v:,.0f}") if "#,##0" in (cell.number_format or "") else len(str(v))
            else:
                n = len(str(v))
            w = max(w, n)
        ws.column_dimensions[get_column_letter(c)].width = min(max(w + 2, min_w), cap)


def _thin_borders(ws, r1, c1, r2, c2, color="C8C8C8"):
    side = Side(style="thin", color=color)
    for row in ws.iter_rows(min_row=r1, max_row=r2, min_col=c1, max_col=c2):
        for cell in row:
            cell.border = Border(left=side, right=side, top=side, bottom=side)


def _num(v, default=0.0):
    n = to_num(v)
    return default if n is None else n


