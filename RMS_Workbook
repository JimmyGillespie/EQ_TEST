def write_locations(wb, locs):
    ws = wb.create_sheet("Locations")
    for c, h in enumerate(ALL_LOC_HEADERS, 1):
        ws.cell(1, c, h).font = Font(bold=True)
    for r, d in enumerate(locs, 2):
        for c, h in enumerate(ALL_LOC_HEADERS, 1):
            v = d.get(h)
            if h != "Postal Code":
                v = xl(v)
            ws.cell(r, c, v)
    last = max(len(locs) + 1, 1)
    for r in range(2, last + 1):
        for c in range(5, 9):
            ws.cell(r, c).number_format = "#,##0"
    ws.auto_filter.ref = f"A1:{get_column_letter(len(ALL_LOC_HEADERS))}{last}"
    _autofit(ws, 1, len(ALL_LOC_HEADERS), cap=60)
    return ws


def write_map(wb, map_rows):
    ws = wb.create_sheet("Map")
    for c, h in enumerate(["Latitude", "Longitude", "Lat,Long", "Location TIV Sum", "LocID Count"], 1):
        ws.cell(1, c, h).font = Font(bold=True)
    for r, v in enumerate(map_rows, 2):
        ws.cell(r, 1, xl(v[0]))
        ws.cell(r, 2, xl(v[1]))
        ws.cell(r, 3, v[2])
        ws.cell(r, 4, v[4]).number_format = "#,##0"
        ws.cell(r, 5, v[3]).number_format = "0"
    ws.auto_filter.ref = f"A1:E{max(len(map_rows) + 1, 1)}"
    _autofit(ws, 1, 5)
    return ws


