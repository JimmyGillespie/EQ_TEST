def _mi_scaffold(ws, base):
    labels = ["Result Set:", "Analysis ID used:", "Index 1", "Index 2", "Portfolio Name:", "Exposure ID:",
              "Analysis Name:", "Layer:", "Analysis ID (API):", "Peril:", "Peril Code:", "Subperil:",
              "Perspective:", "EP Type"]
    for i, lab in enumerate(labels):
        ws.cell(2 + i, 1, lab)
    for ii, rp in enumerate(RP_LIST):
        ws.cell(base + ii, 1, rp)
    n = len(RP_LIST)
    ws.cell(base + n, 1, "Pure Premium:")
    ws.cell(base + n + 1, 1, "Std Dev:")
    ws.cell(base + n + 2, 1, "CV:")
    for r in range(1, base + n + 3):
        ws.cell(r, 1).font = Font(bold=True)


def _mi_header(ws, start_col, end_col, text, green=False):
    if end_col <= start_col:
        end_col = start_col
    if end_col > start_col:
        ws.merge_cells(start_row=1, start_column=start_col, end_row=1, end_column=end_col)
    cell = ws.cell(1, start_col, text)
    cell.font = Font(bold=True, color="006400") if green else Font(bold=True)
    cell.fill = _fill("E2EFDA" if green else GREY)
    cell.alignment = Alignment(horizontal="center")


def _mi_result_block(ws, d, label, analysis_id, base, col, layer):
    start = col
    n = len(RP_LIST)
    for p in ("GU", "GR", "RL"):
        for ep in ("AEP", "OEP"):
            arr = d["epDict"].get(f"{p}_{ep}")
            if arr is None:
                continue
            idx = f"{p}_{ep}_{d['perilCode']}_{layer}"
            vals = {2: label, 3: analysis_id, 4: idx, 5: idx, 6: d["portfolioName"], 7: d["exposureID"],
                    8: d["analysisName"], 9: layer, 10: analysis_id, 11: d["peril"], 12: d["perilCode"],
                    13: d["subPeril"], 14: p, 15: ep}
            for r, v in vals.items():
                ws.cell(r, col, xl(v) if v != "" else None)
            for ii, v in enumerate(arr):
                ws.cell(base + ii, col, v)
            st = d["statsDict"].get(p, (None, None, None))
            for k in range(3):
                ws.cell(base + n + k, col, st[k])
            col += 1
    if col > start:
        _mi_header(ws, start, col - 1, f"{layer} - {label}")
    return col


def _mi_marginal_block(ws, g, p_, label, base, col, layer):
    start = col
    n = len(RP_LIST)
    for p in ("GU", "GR", "RL"):
        for ep in ("AEP", "OEP"):
            k = f"{p}_{ep}"
            if k not in g["epDict"] or k not in p_["epDict"]:
                continue
            idx = f"{p}_{ep}_{g['perilCode']}_{layer}"
            vals = {2: label, 3: f"{g['analysisId']} - {p_['analysisId']}", 4: idx, 5: idx,
                    6: g["portfolioName"], 9: layer, 11: g["peril"], 12: g["perilCode"],
                    13: g["subPeril"], 14: p, 15: ep}
            for r, v in vals.items():
                ws.cell(r, col, xl(v) if v != "" else None)
            ga, pa = g["epDict"][k], p_["epDict"][k]
            # VBA: Empty array slots are IsNumeric()==True and count as 0
            for ii in range(n):
                ws.cell(base + ii, col, _num(ga[ii]) - _num(pa[ii]))
            gs, ps = g["statsDict"].get(p, (None,) * 3), p_["statsDict"].get(p, (None,) * 3)
            for j in range(3):
                if gs[j] is not None and ps[j] is not None:      # blank/non-numeric -> not written
                    ws.cell(base + n + j, col, gs[j] - ps[j])
            col += 1
    if col > start:
        _mi_header(ws, start, col - 1, f"{layer} - {label}", green=True)
    return col


def write_marginal_impact(wb, mi):
    ws = wb.create_sheet("Marginal Impact")
    base = 16
    ws["A1"] = MI_A1
    _mi_scaffold(ws, base)
    layer = mi["layer"]
    col = 2
    col = _mi_result_block(ws, mi["quote"], "Quote (EQ)", mi["quote_id"], base, col, layer)
    col = _mi_result_block(ws, mi["portfolio"], "Portfolio (in-force)", mi["portfolio_id"], base, col, layer)
    col = _mi_result_block(ws, mi["grouped"], "Quote + Portfolio (Grouped)", mi["group_id"], base, col, layer)
    col = _mi_marginal_block(ws, mi["grouped"], mi["portfolio"], "Marginal Impact (Grouped minus Portfolio)",
                             base, col, layer)
    _autofit(ws, 2, max(col - 1, 2), skip_cols=())
    ws.column_dimensions["A"].width = 22
    return ws


