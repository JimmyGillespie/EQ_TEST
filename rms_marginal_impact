    {"perilCode": "WT", "regionCode": "NA", "modelRegionCode": "NAWT", "eventRateSchemeId": 27, "simulationSetId": 58, "simulationPeriods": 100000, "engineVersion": "RL24"},
    {"perilCode": "FL", "regionCode": "US", "modelRegionCode": "USFL", "eventRateSchemeId": 0, "simulationSetId": 36, "simulationPeriods": 51200000, "engineVersion": "HDv1.2"},
