"""
rms_marginal_impact.py
======================
Python port of the WORKING VBA module modMarginalImpact (Btn_RunMarginalImpact).
No Streamlit dependency - import it from the app and call run().

What it does (same flow as the VBA, same order):
  1. Resolve appAnalysisId -> long analysisId (paged scan of /platform/riskdata/v1/analyses),
     unless a long id is supplied.
  2. PASS 1  POST /platform/grouping/v1/jobs for EVERY layer up front
            (resourceUris = [Portfolio, Quote], full settings incl. currency + regionPerilSimulationSet)
            -> 201 + Location header = job URL.
  3. PASS 2  Poll all job URLs together until FINISHED / FAILED / CANCELLED.
  4. PASS 3  Find the grouped analysisId (job details.resources[] -> fallback: search by analysisName),
            fetch EP + stats (GU/GR/RL, AEP/OEP) for Quote, Portfolio, Grouped, and compute
            Marginal = Grouped - Portfolio.

CREDENTIALS - identical to the VBA:
  * grouping calls  : grouping key (VBA: RMS_KEY_GROUPING) + grouping resource-group-id,
                      Authorization header = the raw key (no "Bearer").
  * everything else : risk-data key (VBA: RMS_KEY_RISKDATA), Authorization = raw key, no resource-group header.
"""
from __future__ import annotations

import json
import re
import time
import urllib.parse
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from typing import Callable, Dict, List, Optional, Tuple

import requests

# --------------------------------------------------------------------------- constants (match VBA)
DEFAULT_HOST = "api-euw1.rms.com"
RETURN_PERIODS = [10000, 5000, 1000, 500, 250, 200, 100, 50, 25, 10, 5, 2]   # MI_RP_LIST
PERSPECTIVES = ["GU", "GR", "RL"]
EP_TYPES = ["AEP", "OEP"]
EXPOSURE_TYPE_DEFAULT = "8017"          # MI_EXPOSURE_TYPE
GROUP_NAME_MAXLEN = 64                  # MI_GROUP_ANALYSISNAME_MAXLEN
POLL_SECONDS = 15                       # MI_POLL_SECONDS
POLL_MAX_ATTEMPTS = 240                 # MI_POLL_MAX_ATTEMPTS
SCAN_PAGES = 50
SCAN_PAGE_SIZE = 100

